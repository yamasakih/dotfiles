{
  "respectGitignore": true,
{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.hostname "HiroyukinoMacBook-Pro") }}
  "env": {
    "ANTHROPIC_MODEL": "claude-sonnet-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-6",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5@20251001",
    "VERTEX_REGION_CLAUDE_4_6_OPUS": "us-east5",
    "VERTEX_REGION_CLAUDE_4_6_SONNET": "us-east5",
    "VERTEX_REGION_CLAUDE_HAIKU_4_5": "us-east5",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
{{- else }}
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
{{- end }}
  "permissions": {
    "allow": [
      "Bash",
      "MultiEdit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "mcp__github__create_pull_request",
      "mcp__github__get_issue",
      "mcp__github__add_issue_comment",
      "mcp__github__get_issue_comments"
{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.hostname "HiroyukinoMacBook-Pro") }},
      "Read(~/cortex/**)",
      "Write(~/cortex/**)",
      "Read(~/.memp/**)",
      "mcp__snowflake-mcp-workato__cortex_search_slack",
      "mcp__snowflake-mcp-workato__cortex_search_zra_summaries",
      "mcp__snowflake-mcp-workato__snowflake_get_schema",
      "mcp__snowflake-mcp-workato__snowflake_query"
{{- end }}
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(chmod 777:*)",
      "Bash(chown root:*)",
      "Bash(while true:*)",
      "Bash\\(for \\(\\(;;\\):*\\)",
      "Bash(terraform destroy:*)",
      "Bash(terraform apply:*)",
      "Bash(gcloud:*)",
      "Bash(gsutil:*)",
      "Bash(bq:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(netcat *)",
      "Bash(socat *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(sftp *)",
      "Bash(ftp *)",
      "Bash(telnet *)",
      "Bash(nmap *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/context-bar.sh"
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "cortex@caddi-ai-tooling": true,
    "empirical-prompt-tuning@caddi-ai-tooling": true,
    "memp@caddi-ai-tooling": true,
    "ml-for-app@caddi-ai-tooling": true
  },
  "effortLevel": "medium",
  "skipWorkflowUsageWarning": true,
  "memory": "auto",
  "detectSecrets": true,
{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.hostname "HiroyukinoMacBook-Pro") }}
  "autoUpdatesChannel": "stable",
{{- end }}
  "model": "opus",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "filesystem": {
      "allowWrite": ["~/.memp", ".git", "/tmp/herdr-team"]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org"
      ],
      "allowLocalBinding": true
    },
    "excludedCommands": ["herdr *", "ygrep *", "rtk *", "gh *", "npm *"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/hiroyuki_yamasaki_caddi_jp/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/hiroyuki_yamasaki_caddi_jp/.claude/hooks/handoff-approve.sh"
          },
          {
            "type": "command",
            "command": "/home/hiroyuki_yamasaki_caddi_jp/.claude/hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "/home/hiroyuki_yamasaki_caddi_jp/.claude/hooks/block-main-push.sh"
          },
          {
            "type": "command",
            "command": "/home/hiroyuki_yamasaki_caddi_jp/.claude/hooks/block-external-send.sh"
          }
        ]
      }
    ]
  }
}
