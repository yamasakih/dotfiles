{
  "respectGitignore": true,
{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.hostname "HiroyukinoMacBook-Pro") }}
  "env": {
    "ANTHROPIC_MODEL": "claude-sonnet-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-6",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
{{- else }}
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
{{- end }}
  "permissions": {
    "allow": [
      "Bash",
      "WebFetch",
      "WebSearch",
      "mcp__github__create_pull_request",
      "mcp__github__get_issue",
      "mcp__github__add_issue_comment",
      "mcp__github__get_issue_comments"
{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.hostname "HiroyukinoMacBook-Pro") }},
      "Read(~/cortex/**)",
      "Edit(~/cortex/**)",
      "Read(~/.memp/**)",
      "mcp__snowflake-mcp-workato__cortex_search_slack",
      "mcp__snowflake-mcp-workato__cortex_search_zra_summaries",
      "mcp__snowflake-mcp-workato__snowflake_get_schema",
      "mcp__snowflake-mcp-workato__snowflake_query"
{{- end }}
    ],
    "deny": [
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(netcat *)",
      "Bash(socat *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(sftp *)",
      "Bash(ftp *)",
      "Bash(telnet *)",
      "Bash(nmap *)",
      "Bash(sudo*)",
      "Read(.env)",
      "Read(~/.ssh)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(rm*)",
      "Bash(rmdir*)",
      "Bash(gh*)",
      "Bash(terraform destory*)",
      "Bash(terraform apply*)",
      "Bash(gcloud:*)",
      "Bash(gsutil:*)",
      "Bash(curl*)",
      "Bash(bg:*)"
    ],
    "disableBypassPermissinosMode": "disable"
  },
  "defaultMode": "auto",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/context-bar.sh"
  },
  "extraKnownMarketplaces": {
    "caddi-ai-tooling": {
      "source": {
        "source": "github",
        "repo": "caddi-sandbox/ai-tooling"
      }
    }
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "cortex@caddi-ai-tooling": true,
    "empirical-prompt-tuning@caddi-ai-tooling": false,
    "memp@caddi-ai-tooling": true,
    "ml-for-app@caddi-ai-tooling": true
  },
  "skillOverrides": {
    "databricks-agent-bricks": "off",
    "databricks-app-design": "off",
    "databricks-dbsql": "off",
    "databricks-execution-compute": "off",
    "databricks-iceberg": "off",
    "databricks-jobs": "off",
    "databricks-lakeflow-connect": "off",
    "databricks-metric-views": "off",
    "databricks-mlflow-evaluation": "off",
    "databricks-ml-training": "off",
    "databricks-model-serving": "off",
    "databricks-pipelines": "off",
    "databricks-python-sdk": "off",
    "databricks-serverless-migration": "off",
    "databricks-spark-structured-streaming": "off",
    "databricks-synthetic-data-gen": "off",
    "databricks-unstructured-pdf-generation": "off",
    "databricks-zerobus-ingest": "off",
    "yukkuri-style": "off"
  },
  "effortLevel": "medium",
  "skipWorkflowUsageWarning": true,
  "memory": "auto",
  "detectSecrets": true,
{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.hostname "HiroyukinoMacBook-Pro") }}
  "autoUpdatesChannel": "stable",
{{- end }}
  "model": "opus",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "filesystem": {
      "allowWrite": ["~/.memp", ".git", "~/.agents/skills/agmsg/db", "~/.agents/skills/agmsg/run", "~/.agents/skills/agmsg/teams"]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org"
      ],
      "allowLocalBinding": true
    },
    "excludedCommands": ["herdr *", "ygrep *", "rtk *", "gh *", "npm *"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/hiroyuki_yamasaki_caddi_jp/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.hostname "HiroyukinoMacBook-Pro") }}
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/hiroyuki_yamasaki_caddi_jp/.claude/hooks/handoff-approve.sh"
          },
          {
            "type": "command",
            "command": "/home/hiroyuki_yamasaki_caddi_jp/.claude/hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "/home/hiroyuki_yamasaki_caddi_jp/.claude/hooks/block-main-push.sh"
          },
          {
            "type": "command",
            "command": "/home/hiroyuki_yamasaki_caddi_jp/.claude/hooks/block-external-send.sh"
          }
        ]
      }
    ]
{{- end }}
  }
}
