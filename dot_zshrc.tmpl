# SSH 上でも動く pbcopy
function pbcopy() {
    local input=$(cat | base64 | tr -d '\n')
    printf "\033]52;c;%s\007" "$input"
}

# just deploy の app/tenant を補完する (orbit-outpost-apps)
# Homebrew (brew shellenv) が公式の _just 補完を site-functions に入れており、
# fpath の先頭に置かないと autoload がそちらを優先して読み込んでしまう。
if [ -d "$HOME/orbit-outpost-apps/scripts/completions" ]; then
    fpath=("$HOME/orbit-outpost-apps/scripts/completions" $fpath)
    unfunction _just 2>/dev/null
    autoload -Uz _just
    compdef _just just
fi
{{ end }}

# yazi を y で開く&移動したフォルダに yazi を閉じた後も移動している
function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
             builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}

# zoxide
# ターミナルが対話操作（Interactive）の時だけ cd を上書きする
if [[ $- == *i* ]]; then
    eval "$(zoxide init zsh --cmd cd)"
fi

